# Presento web 환경 변수 예시. 이 파일을 .env.local 로 복사해서 값을 채우세요.
#   cp .env.example .env.local

# 백엔드 API 주소 (명세 v2 0장: 공개 HTTPS 터널. 로컬 백엔드를 직접 띄우면 http://localhost:8000/api/v1)
VITE_API_BASE_URL=https://rose-code-korean-teaching.trycloudflare.com/api/v1

# true 면 MSW 목업으로 동작합니다 (백엔드 없이 개발·시연).
# 실제 서버에 붙일 때는 false 로 두세요.
VITE_USE_MOCK=false
